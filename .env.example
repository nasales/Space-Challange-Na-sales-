# Copy to .env (gitignored) for local development. Used only by the local Python API
# (npm run dev:api), which is not deployed. Server-side only: never prefix with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend (read only, public by design): the PUBLISHABLE key (sb_publishable_...), never the secret one.
# Read at BUILD time by Vite: on Cloudflare set them as build variables, then redeploy.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
